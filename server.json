{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.guhttps/veu",
  "title": "Véu",
  "description": "Hides personal data and secrets before text reaches an AI and restores them in the answer.",
  "repository": {
    "url": "https://github.com/guhttps/veu",
    "source": "github"
  },
  "version": "0.6.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "veu",
      "version": "0.6.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "named", "name": "--from", "value": "veu[mcp]" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}
