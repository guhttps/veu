{
  "description": "Véu: bloqueia segredos nos prompts, a leitura de arquivos com segredos e comandos que os mostrariam (cat .env, printenv, buscas); sugere ler_protegido.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "veu gancho prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "veu gancho arquivo",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "veu gancho comando",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
